# 固定上游地址；支持 Docker 网络内 http://tuwunel:8008。
MATRIX_HOMESERVER_URL=https://matrix.example.com
# 浏览器访问本系统的地址（开发前端使用 http://localhost:5173）
PUBLIC_URL=http://localhost:8080
PORT=8080
DATA_DIR=./data
# HTTPS 反向代理部署时必须设为 true
COOKIE_SECURE=false
# 可选：32 字节随机密钥的 base64；留空时自动在数据卷生成 encryption.key
# ENCRYPTION_KEY=
