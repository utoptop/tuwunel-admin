{
  "name": "tuwunel-admin",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "cargo run -- --config config.toml",
    "build": "tsc -b && vite build",
    "start": "./target/release/tuwunel-admin --config config.toml",
    "test": "cargo test && cargo build && node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
